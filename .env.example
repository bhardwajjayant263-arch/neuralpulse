# ==============================================================================
# neuralpulse.hq - Environment Configuration
# ==============================================================================

# Meta / Instagram Graph API Configuration
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_custom_webhook_verify_token
META_ACCESS_TOKEN=your_instagram_graph_api_long_lived_access_token
META_IG_USER_ID=your_instagram_business_account_id
GRAPH_API_VERSION=v21.0

# Google Generative AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vercel KV (Upstash Redis)
# Automatically populated when linking Vercel KV in the Vercel Dashboard
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your_kv_rest_token_here
KV_REST_API_READ_ONLY_TOKEN=optional_read_only_token_here

# Runtime & Logging
NODE_ENV=development
LOG_LEVEL=info
