{
  "name": "neuralpulse-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js/TypeScript backend for neuralpulse.hq with Vercel Serverless, Vercel KV, and Gemini LLM",
  "main": "api/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "neuralpulse",
    "meta-graph-api",
